    {
      "id": "b6ecac9d-1b7a-4d2b-a5f5-78c93f6a1b01",
      "name": "Workflow Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [160, 20],
      "parameters": {
        "content": "## Workflow Overview\nReceives a lead through an n8n-hosted form, normalizes expected fields, stores the raw lead in Airtable, scores the lead with OpenAI, updates Airtable with the score, and alerts Slack only for High-fit leads.\n\nPrimary path: Form Trigger -> Normalize -> Raw CRM save -> AI qualification -> Score prep -> High Score? -> Airtable/Slack.",
        "height": 240,
        "width": 460,
        "color": 4
      }
    },
    {
      "id": "df5b1898-90d6-4c8f-8172-399359311223",
      "name": "Setup Checklist",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [720, 20],
      "parameters": {
        "content": "## Setup Checklist\nBefore activation, verify:\n1. Airtable credential is connected.\n2. Airtable base/table point to the Leads table.\n3. Leads table has all mapped fields and Email can be used for upsert matching.\n4. OpenAI credential is connected and model access works.\n5. Slack credential is connected and the bot is in the leads channel.\n6. Replace REPLACE_WITH_BOOKING_LINK in the Slack message.\n7. Open the form test URL, submit a sample lead, and verify both routing paths before activating.",
        "height": 300,
        "width": 480,
        "color": 5
      }
    },
    {
      "id": "ab10f6fd-15b9-4099-8097-e488f9df1e9f",
      "name": "Process Watchouts",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1340, 20],
      "parameters": {
        "content": "## Process Watchouts\n- The form field names must stay aligned with normalization: name, email, company, company_size, budget, urgency, and message.\n- Raw lead data is saved before AI scoring for auditability.\n- AI must return score, confidence, reasoning, recommended_action, and icp_fit.\n- High leads alert Slack; Medium/Low leads only update Airtable.\n- Keep the workflow inactive until the booking link and a successful end-to-end test are complete.",
        "height": 280,
        "width": 480,
        "color": 6
      }
    }
  ],
  "nodeGroups": [
    {
      "name": "Normalize and Raw Capture",
      "nodeNames": ["Normalize Lead Fields", "Store Raw Lead in Airtable"],
      "description": "Standardizes form data and saves the raw lead before AI scoring."
    },
    {
      "name": "AI Qualification",
      "nodeNames": ["Qualify Lead with AI", "OpenAI Lead Scoring Model", "Lead Score Parser"],
      "description": "Scores the lead with structured OpenAI output."
    },
    {
      "name": "High Lead Alert Path",
      "nodeNames": ["Update Airtable - High Lead", "Alert Sales in Slack"],
      "description": "Updates CRM and alerts Slack when score is High."
    },
    {
      "name": "Standard Lead Path",
      "nodeNames": ["Update Airtable - Standard Lead"],
      "description": "Updates CRM for Medium or Low leads."
    }
  ],
  "connections": {
    "Lead Intake Form": { "main": [[{ "node": "Normalize Lead Fields", "type": "main", "index": 0 }]] },
    "Normalize Lead Fields": { "main": [[{ "node": "Store Raw Lead in Airtable", "type": "main", "index": 0 }]] },
    "Store Raw Lead in Airtable": { "main": [[{ "node": "Qualify Lead with AI", "type": "main", "index": 0 }]] },
    "Qualify Lead with AI": { "main": [[{ "node": "Prepare Scored Lead", "type": "main", "index": 0 }]] },
    "OpenAI Lead Scoring Model": { "ai_languageModel": [[{ "node": "Qualify Lead with AI", "type": "ai_languageModel", "index": 0 }]] },
    "Lead Score Parser": { "ai_outputParser": [[{ "node": "Qualify Lead with AI", "type": "ai_outputParser", "index": 0 }]] },
    "Prepare Scored Lead": { "main": [[{ "node": "High Score?", "type": "main", "index": 0 }]] },
    "High Score?": {
      "main": [
        [{ "node": "Update Airtable - High Lead", "type": "main", "index": 0 }],
        [{ "node": "Update Airtable - Standard Lead", "type": "main", "index": 0 }]
      ]
    },
    "Update Airtable - High Lead": { "main": [[{ "node": "Alert Sales in Slack", "type": "main", "index": 0 }]] },
    "Update Airtable - Standard Lead": { "main": [[]] }
  }
