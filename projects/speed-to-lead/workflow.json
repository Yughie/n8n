{
  "id": "GstgtVYxyhRZLYZz",
  "name": "Speed-to-Lead AI Qualification & CRM Auto-Router",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "nodes": [
    {
      "id": "414b8212-7f43-4dae-b46c-caed1f965808",
      "name": "Lead Intake Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [200, 300],
      "parameters": {
        "authentication": "none",
        "formTitle": "Lead Qualification Request",
        "formDescription": "Tell us about your company and what you need. High-fit requests are routed to the sales team automatically.",
        "formFields": {
          "values": [
            { "fieldLabel": "Full name", "fieldName": "name", "fieldType": "text", "placeholder": "Jane Doe", "requiredField": true },
            { "fieldLabel": "Work email", "fieldName": "email", "fieldType": "email", "placeholder": "jane@company.com", "requiredField": true },
            { "fieldLabel": "Company", "fieldName": "company", "fieldType": "text", "placeholder": "Company name", "requiredField": true },
            {
              "fieldLabel": "Company size",
              "fieldName": "company_size",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  { "option": "1-10" },
                  { "option": "11-50" },
                  { "option": "51-200" },
                  { "option": "201-500" },
                  { "option": "501+" }
                ]
              }
            },
            {
              "fieldLabel": "Estimated budget",
              "fieldName": "budget",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  { "option": "Under $1k" },
                  { "option": "$1k-$5k" },
                  { "option": "$5k-$10k" },
                  { "option": "$10k+" },
                  { "option": "Not sure yet" }
                ]
              }
            },
            {
              "fieldLabel": "Timeline / urgency",
              "fieldName": "urgency",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  { "option": "ASAP" },
                  { "option": "This month" },
                  { "option": "This quarter" },
                  { "option": "Exploring options" }
                ]
              }
            },
            { "fieldLabel": "What do you need help with?", "fieldName": "message", "fieldType": "textarea", "placeholder": "Briefly describe the project, challenge, or goal.", "requiredField": true }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "speed-to-lead",
          "buttonLabel": "Submit request",
          "appendAttribution": false,
          "ignoreBots": true,
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thanks. Your request has been received."
            }
          }
        }
      }
    },
    {
      "id": "6e5c8722-2b8c-4197-8845-91eadf823f7f",
      "name": "Normalize Lead Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [460, 300],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            { "id": "name", "name": "name", "value": "={{ $json.body?.name ?? $json.name ?? \"\" }}", "type": "string" },
            { "id": "email", "name": "email", "value": "={{ $json.body?.email ?? $json.email ?? \"\" }}", "type": "string" },
            { "id": "company", "name": "company", "value": "={{ $json.body?.company ?? $json.company ?? \"\" }}", "type": "string" },
            { "id": "company_size", "name": "company_size", "value": "={{ $json.body?.company_size ?? $json.company_size ?? \"\" }}", "type": "string" },
            { "id": "budget", "name": "budget", "value": "={{ $json.body?.budget ?? $json.budget ?? \"\" }}", "type": "string" },
            { "id": "urgency", "name": "urgency", "value": "={{ $json.body?.urgency ?? $json.urgency ?? \"\" }}", "type": "string" },
            { "id": "message", "name": "message", "value": "={{ $json.body?.message ?? $json.message ?? \"\" }}", "type": "string" },
            { "id": "raw_payload", "name": "raw_payload", "value": "={{ JSON.stringify($json.body ?? $json) }}", "type": "string" },
            { "id": "received_at", "name": "received_at", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "39eb6d2d-939a-4c3a-8202-720271bc100d",
      "name": "Store Raw Lead in Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [740, 300],
      "parameters": {
        "resource": "record",
        "operation": "upsert",
        "authentication": "airtableTokenApi",
        "base": { "__rl": true, "mode": "id", "value": "app_REPLACE_WITH_AIRTABLE_BASE_ID" },
        "table": { "__rl": true, "mode": "id", "value": "tbl_REPLACE_WITH_LEADS_TABLE_ID" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["Email"],
          "value": {
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Company": "={{ $json.company }}",
            "Company Size": "={{ $json.company_size }}",
            "Budget": "={{ $json.budget }}",
            "Urgency": "={{ $json.urgency }}",
            "Message": "={{ $json.message }}",
            "Raw Payload": "={{ $json.raw_payload }}",
            "Received At": "={{ $json.received_at }}",
            "Status": "New"
          },
          "schema": [
            { "id": "Name", "displayName": "Name", "type": "string", "canBeUsedToMatch": false },
            { "id": "Email", "displayName": "Email", "type": "string", "canBeUsedToMatch": true },
            { "id": "Company", "displayName": "Company", "type": "string", "canBeUsedToMatch": false },
            { "id": "Company Size", "displayName": "Company Size", "type": "string", "canBeUsedToMatch": false },
            { "id": "Budget", "displayName": "Budget", "type": "string", "canBeUsedToMatch": false },
            { "id": "Urgency", "displayName": "Urgency", "type": "string", "canBeUsedToMatch": false },
            { "id": "Message", "displayName": "Message", "type": "string", "canBeUsedToMatch": false },
            { "id": "Raw Payload", "displayName": "Raw Payload", "type": "string", "canBeUsedToMatch": false },
            { "id": "Received At", "displayName": "Received At", "type": "string", "canBeUsedToMatch": false },
            { "id": "Status", "displayName": "Status", "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": { "typecast": true }
      }
    },
    {
      "id": "e5e7557e-42f5-4d9a-a6f5-f445d1ede70b",
      "name": "Qualify Lead with AI",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1020, 300],
      "parameters": {
        "promptType": "define",
        "text": "=Evaluate this inbound lead against the ICP and return structured JSON only. Lead: Name={{ $(\"Normalize Lead Fields\").item.json.name }}, Email={{ $(\"Normalize Lead Fields\").item.json.email }}, Company={{ $(\"Normalize Lead Fields\").item.json.company }}, Company Size={{ $(\"Normalize Lead Fields\").item.json.company_size }}, Budget={{ $(\"Normalize Lead Fields\").item.json.budget }}, Urgency={{ $(\"Normalize Lead Fields\").item.json.urgency }}, Message={{ $(\"Normalize Lead Fields\").item.json.message }}. Scoring guide: High means strong budget, meaningful company size, and urgent timeline. Medium means partial fit or unclear urgency/budget. Low means poor fit, no budget, non-buyer, spam, vendor, student, or low urgency.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a B2B speed-to-lead qualification assistant. Score inbound leads as High, Medium, or Low using budget, company size, urgency, and ICP fit. Return only the parser schema fields. Include concise reasoning and recommended next action.",
          "maxIterations": 3,
          "returnIntermediateSteps": false
        }
      }
    },
    {
      "id": "bfe7d66b-8381-4308-bf63-1ba3330d72d8",
      "name": "OpenAI Lead Scoring Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [1020, 520],
      "parameters": {
        "model": { "__rl": true, "mode": "id", "value": "gpt-5-mini" },
        "responsesApiEnabled": true,
        "options": {
          "temperature": 0.1,
          "reasoningEffort": "low",
          "maxRetries": 2,
          "timeout": 60000
        }
      }
    },
    {
      "id": "2b1c2149-8f95-43a5-9c9a-8118c9a8c688",
      "name": "Lead Score Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [1220, 520],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"score\":\"High\",\"confidence\":0.92,\"reasoning\":\"Budget, company size, and urgency match the ICP.\",\"recommended_action\":\"Send immediate sales alert.\",\"icp_fit\":[\"Budget fit\",\"Urgent timeline\"]}",
        "autoFix": false
      }
    },
    {
      "id": "eb7253f1-4348-4bc2-9e41-fdd7f9ef7d3f",
      "name": "Prepare Scored Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1300, 300],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            { "id": "name", "name": "name", "value": "={{ $(\"Normalize Lead Fields\").item.json.name }}", "type": "string" },
            { "id": "email", "name": "email", "value": "={{ $(\"Normalize Lead Fields\").item.json.email }}", "type": "string" },
            { "id": "company", "name": "company", "value": "={{ $(\"Normalize Lead Fields\").item.json.company }}", "type": "string" },
            { "id": "company_size", "name": "company_size", "value": "={{ $(\"Normalize Lead Fields\").item.json.company_size }}", "type": "string" },
            { "id": "budget", "name": "budget", "value": "={{ $(\"Normalize Lead Fields\").item.json.budget }}", "type": "string" },
            { "id": "urgency", "name": "urgency", "value": "={{ $(\"Normalize Lead Fields\").item.json.urgency }}", "type": "string" },
            { "id": "message", "name": "message", "value": "={{ $(\"Normalize Lead Fields\").item.json.message }}", "type": "string" },
            { "id": "raw_payload", "name": "raw_payload", "value": "={{ $(\"Normalize Lead Fields\").item.json.raw_payload }}", "type": "string" },
            { "id": "received_at", "name": "received_at", "value": "={{ $(\"Normalize Lead Fields\").item.json.received_at }}", "type": "string" },
            { "id": "score", "name": "score", "value": "={{ $json.output.score }}", "type": "string" },
            { "id": "confidence", "name": "confidence", "value": "={{ $json.output.confidence }}", "type": "number" },
            { "id": "reasoning", "name": "reasoning", "value": "={{ $json.output.reasoning }}", "type": "string" },
            { "id": "recommended_action", "name": "recommended_action", "value": "={{ $json.output.recommended_action }}", "type": "string" },
            { "id": "icp_fit", "name": "icp_fit", "value": "={{ ($json.output.icp_fit || []).join(\", \") }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "88085dfb-f371-439b-93ac-0fecafdf86a8",
      "name": "High Score?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1560, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "score-high",
              "leftValue": "={{ $json.score }}",
              "operator": { "type": "string", "operation": "equals" },
              "rightValue": "High"
            }
          ],
          "combinator": "and"
        }
      }
    },
